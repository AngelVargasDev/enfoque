# Normaliza finales de línea: código y textos en LF, scripts de Windows en CRLF.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.pro text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
